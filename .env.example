# Learning Analytics Framework - Environment Variables Example
# Copy this file to .env and configure as needed

# Python Configuration
PYTHONPATH=.

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s

# Model Configuration
RANDOM_SEED=42
TRAIN_FRACTION=0.70
VALIDATION_FRACTION=0.15
TEST_FRACTION=0.15

# CO Attainment Threshold
CO_ATTAINMENT_THRESHOLD_PERCENT=65.0

# Optional: External Services (for future enhancements)
# DATABASE_URL=
# API_KEY=
# SECRET_KEY=

# Optional: Model Storage
# MODEL_CACHE_DIR=./models
# FIGURE_CACHE_DIR=./figures

# Optional: Reporting
# REPORT_FORMAT=markdown
# EXPORT_PDF=false
